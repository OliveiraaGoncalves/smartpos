<?xml version="1.0" encoding="utf-8"?>
<!-- Proíbe tráfego em texto claro: toda comunicação com o backend é HTTPS (TLS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
